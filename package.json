{
  "name": "touchline-match-companion",
  "version": "0.5.0",
  "private": true,
  "description": "Evidence-grounded synthetic football companion with Microsoft Foundry story ranking",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.cjs",
    "test": "node --test tests/*.cjs",
    "evaluate": "node tools/evaluate-context.cjs",
    "check:usability": "node tools/check-usability.cjs",
    "check:fan": "node tools/check-fan-experience.cjs",
    "check:viewer": "node tools/check-viewer-milestone.cjs",
    "check:investigation": "node tools/check-investigation.cjs",
    "evaluate:scenarios": "node tools/evaluate-scenarios.cjs",
    "evaluate:scenarios:holdout": "node tools/evaluate-scenarios.cjs --split=holdout",
    "evaluate:agent": "node tools/evaluate-agent.cjs",
    "check:agent": "node tools/check-agent.cjs",
    "evaluate:comparative": "node tools/evaluate-comparative.cjs",
    "evaluate:narrative": "node tools/evaluate-narrative.cjs"
  }
}
