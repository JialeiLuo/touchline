# Copy to .env locally. Never commit .env or paste keys into chat.
# Use an Azure OpenAI v1 endpoint from your Microsoft Foundry deployment.
AZURE_FOUNDRY_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_FOUNDRY_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_FOUNDRY_API_KEY=
PORT=8767
HOST=127.0.0.1

# Persistent SINGLE-PROCESS demo allowance. Reservations include failed calls.
TOUCHLINE_AI_DAILY_LIMIT=200
TOUCHLINE_AI_TOTAL_LIMIT=2000
TOUCHLINE_REQUESTS_PER_MINUTE=30
# Use a persistent writable volume on a hosted service.
# TOUCHLINE_STATE_DIR=/persistent/touchline

# The local investigator uses up to 4 model requests per explanation.
# Each request reserves one daily/total allowance unit; cached results reserve none.
# Request/time/token-estimate/tool limits are server-owned (docs/BOUNDED_INVESTIGATOR.md).
